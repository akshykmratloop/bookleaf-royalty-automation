{
  "name": "BookLeaf - Stuck Job Sweeper",
  "nodes": [
    {
      "id": "4dff84af-29f8-408b-ace4-724b33013554",
      "name": "Every Minute",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 1
            }
          ]
        }
      },
      "position": [
        0,
        0
      ]
    },
    {
      "id": "6e468925-4d77-46a0-a677-77b24d82b9dc",
      "name": "Sweep Stuck Jobs",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "parameters": {
        "operation": "executeQuery",
        "query": "WITH s AS (SELECT bookleaf_setting('stuck_job_minutes')::int AS minutes)\nUPDATE royalty_jobs\nSET status = 'FAILED', stage = 'failed', stage_at = now(), error_code = 'TIMEOUT',\n    error = format('The job did not finish within %s minutes, so it was stopped. Send it again if needed.', s.minutes),\n    completed_at = now(), updated_at = now()\nFROM s\nWHERE status IN ('QUEUED', 'PROCESSING')\n  AND (CASE WHEN drafted_at IS NULL THEN created_at ELSE stage_at END) < now() - make_interval(mins => s.minutes)\nRETURNING job_id::text AS job_id, log_id, author_id",
        "options": {}
      },
      "credentials": {
        "postgres": {
          "id": "__CREDENTIAL_postgres__",
          "name": "BookLeaf Postgres (bookleaf db)"
        }
      },
      "position": [
        260,
        0
      ]
    }
  ],
  "connections": {
    "Every Minute": {
      "main": [
        [
          {
            "node": "Sweep Stuck Jobs",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "saveDataErrorExecution": "all",
    "saveDataSuccessExecution": "none",
    "saveManualExecutions": true,
    "callerPolicy": "workflowsFromSameOwner"
  }
}
