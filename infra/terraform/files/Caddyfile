{
	email {$ACME_EMAIL}
}

{$N8N_HOST} {
	encode zstd gzip
	reverse_proxy n8n:5678 {
		# Long-lived editor push connections.
		flush_interval -1
	}
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}
}
